# ── LINE ──────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# ── AI (OpenAI) ───────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
# Model to use — gpt-4o recommended for accuracy
OPENAI_MODEL=gpt-4o

# ── Lark / Feishu ─────────────────────────────────────
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret
# The user_id or open_id that will be set as task collaborator/assignee
LARK_ASSIGNEE_USER_ID=your_lark_user_id

# ── App ───────────────────────────────────────────────
PORT=3000
# Business hours in Asia/Bangkok (UTC+7)
BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=18

# ── HR check-in alert (AppSheet -> LINE group "HR - zinith9") ─────
# Shared secret AppSheet sends in header x-webhook-secret
CHECKIN_WEBHOOK_SECRET=change_me_to_a_long_random_string
# Optional: defaults to the HR - zinith9 group
HR_GROUP_ID=Ce6c789004bf543455234dd166cae5d95
# Optional: Gemini model for payment-slip reading
SLIP_GEMINI_MODEL=gemini-3.5-flash-lite

# Daily 08:55/17:50 greetings (uses LINE Push quota). Off unless set to on
# DAILY_GREETINGS=on
